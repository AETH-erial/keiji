# Copy to /etc/keiji/keiji.env as root:keiji mode 0640 and set credentials.
# This example assumes Caddy terminates TLS and proxies to this loopback address.
HOST_ADDR=127.0.0.1
HOST_PORT=8080
DOMAIN_NAME=example.com
USE_SSL=false
KEIJI_USERNAME=replace-me
KEIJI_PASSWORD=replace-me
SQLITE_PATH=/var/lib/keiji/sqlite.db
IMAGE_STORE=/var/lib/keiji/images
# See pkg/controller/SECURITY.md before configuring trusted proxies.
# KEIJI_TRUSTED_PROXIES=127.0.0.1,::1
